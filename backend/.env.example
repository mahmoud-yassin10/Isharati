# Decrypts pose.enc if poses.json is missing. Optional when backend/poses.json exists.
POSE_KEY=

# Cloudinary (required to store generated .pose files)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Optional: refine sign glosses into Egyptian Arabic
OPENROUTER_API_KEY=
NLP_MODEL_NAME=openai/gpt-4o-mini
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=Raqeeb

# Raqeeb auth (demo default is fine locally; set a long random value in production)
RAQEEB_JWT_SECRET=raqeeb-demo-secret

# Comma-separated extra frontend origins (Vercel URL, etc.)
CORS_ORIGINS=

# SQLite location. Fly mounts a volume at /data.
# RAQEEB_DATA_DIR=/data
